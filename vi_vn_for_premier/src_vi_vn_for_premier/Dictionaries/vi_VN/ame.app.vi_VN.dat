"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/EmbedSVCDUserBlocks=Nhúng khối người dùng SVCD"
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/ForceVBVDelay=Buộc VBV trì hoãn"
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/GOPSettings=Cài đặt GOP"
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/Horizontal=Nằm ngang"
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/IgnoreFrameInterval=Bỏ qua khoảng thời gian khung"
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/IntraDCPrecision=Độ chính xác nội bộ DC"
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/Level=Mức độ"
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/Level_Desc=Ràng buộc các tham số mã hóa như phạm vi tốc độ bit và kích thước khung hình tối đa."
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/MCVideo_AutoGOPPlacement_Desc=Chỉ định xem bộ mã hóa có tự động khởi động GOP mới bất cứ khi nào có thay đổi cảnh hay không."
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/MCVideo_BufferSize_Desc=Kích thước bộ đệm VBV tối thiểu cần thiết để giải mã chuỗi mà không bị tràn hoặc tràn hoặc 0 để sử dụng giá trị mặc định do hệ thống tính toán."
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/MCVideo_ClosedGOP_Desc=Chỉ định khoảng cách của các GOP đã đóng. Một GOP đóng có thể được giải mã bởi chính nó và không tham chiếu đến bất kỳ GOP nào trước đó. Đặt thành 1 để đóng mọi GOP."
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/MCVideo_ColorPrimaries_Desc=tọa độ màu x, y của nguồn gốc. Không ảnh hưởng đến mã hóa."
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/MCVideo_DCPrec_Desc=Chỉ định độ chính xác của các hệ số DC trong macroblock được mã hóa nội bộ. Giá trị cao hơn cải thiện chất lượng ở tốc độ dữ liệu cao, nhưng làm ảnh hưởng đến chất lượng ở tốc độ dữ liệu thấp hơn."
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/MCVideo_EmbedSVCDUsrBlk_Desc=Chỉ định có nhúng khối dữ liệu người dùng SVCD vào luồng video hay không."
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/MCVideo_IgnoreFrameInterv_Desc=Chỉ định khoảng thời gian cho số lượng khung hình bị bỏ qua. Sử dụng 0 để không bỏ qua bất kỳ khung nào."
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/MCVideo_MQuantValue_Desc=Giá trị lượng tử hóa Macroblock."
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/MCVideo_M_Desc=Khoảng cách giữa các khung hình I và P liên tiếp."
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/MCVideo_Matrix_Coefficients_Desc=Matrix Coefficients is used in deriving luminance and chrominance signals from R,G,B."
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/MCVideo_MinFramePercent_Desc=Zero padding occurs if actual frame size is less than target frame size percentage."
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/MCVideo_N_Desc=The distance between consecutive I frames, a multiple of M frames."
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/MCVideo_NoiseControl_Desc=Sensitivity reduces noise above a certain threshold. Reduction affects all sources."
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/MCVideo_PadFramePercent_Desc=Specifies what percentage of the target frame size to zero fill to."
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/MCVideo_ProgSeq_Desc=Program sequence specifies whether video frames are interlaced with fields or are full-frame progressive."
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/MCVideo_SDEFormat_Desc=The representation of the pictures before being encoded. Does not affect encoding."
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/MCVideo_SDEHeight_Desc=Specify the active region\'s vertical size in pixel unit."
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/MCVideo_SDEWidth_Desc=Specify the active region\'s horizontal size in pixel unit."
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/MCVideo_SeqEndCode_Desc=Specifies whether to write a Sequence End Code in video stream or not."
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/MCVideo_TransferCharsDesc=Specifies the opto-electronic transfer characteristic of the source picture. Does not affect encoding."
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/MCVideo_VBVDelay_Desc=Specifies whether the encoder computes a VBV delay or if a fixed value of 0xFFFF is encoded."
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/MCVideo_WriteSDE_Desc=Writes a Sequence Display Extension in every GOP.  DVD output should have this turned on."
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/MFrames=M Frames"
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/MacroblockQuantization=Macroblock Quantization"
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/MatrixCoefficients=Matrix Coefficients"
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/MaximumBitrate=Maximum Bitrate [Mbps]"
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/MinimumBitrate=Minimum Bitrate [Mbps]"
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/MinimumFramePercentage=Minimum Frame Percentage"
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/NFrames=N Frames"
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/NoiseControl=Noise Control"
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/PadFramePercentage=Pad Frame Percentage"
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/Profile=Hồ sơ"
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/Profile_Desc=Giới hạn phạm vi tốc độ bit và kiểm soát các thuộc tính khác như thuật toán nén và định dạng sắc độ.  Chuẩn DVD sử dụng Main Profile."
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/Pulldown=Kéo xuống"
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/Pulldown_Desc=Sử dụng 'Không' cho các nguồn xen kẽ, '2:3' cho các nguồn lũy tiến, '3:2' cho các nguồn 24p chuyển tới NTSC."
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/Quality=Chất lượng"
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/Quality_Desc=Chỉ định cài đặt Ước tính chuyển động để xác định chất lượng của video được mã hóa.  Chất lượng cao hơn sẽ tăng thời gian kết xuất nhưng sẽ không ảnh hưởng đến kích thước tệp."
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/TVStandard=Tiêu chuẩn truyền hình"
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/TVStandard_Desc=Định dạng video.  Mỹ và Nhật Bản sử dụng NTSC, Châu Âu và Châu Á sử dụng PAL."
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/TargetBitrate=Tốc độ bit mục tiêu [Mbps]"
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/TransferCharacteristics=Đặc điểm chuyển giao"
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/VBVBufferSize=Kích thước bộ đệm VBV (x 2Kbyte)"
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/Vertical=Thẳng đứng"
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/VideoFormat=Định dạng Video"
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/WriteSDE=Viết SDE"
"$$$/MediaCore/Exporters/ExporterMPEG2/VideoGroup/WriteSequenceEndCode=Viết mã kết thúc trình tự"
