"$$$/xmp/dc/source_label=Nguồn"
"$$$/xmp/dc/subject_description=Một mảng không có thứ tự các cụm từ mô tả hoặc từ khóa xác định chủ đề nội dung của tài nguyên."
"$$$/xmp/dc/subject_iptc_description=Nhập bất kỳ số lượng từ khóa, thuật ngữ hoặc cụm từ nào được sử dụng để thể hiện chủ đề trong hình ảnh này"
"$$$/xmp/dc/subject_iptc_label=Từ khóa"
"$$$/xmp/dc/subject_label=Từ khóa"
"$$$/xmp/dc/title_description=Tiêu đề của tài liệu hoặc tên được đặt cho tài nguyên. Thông thường, nó sẽ là tên mà tài nguyên được biết đến một cách chính thức."
"$$$/xmp/dc/title_iptc_description=Nhập tên ngắn gọn bằng lời nói và con người có thể đọc được cho hình ảnh này, đây có thể là tên tệp."
"$$$/xmp/dc/title_label=Tiêu đề"
