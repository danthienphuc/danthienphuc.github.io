"$$$/xmp/xmpDM/stretchMode/0=Fixed length"
"$$$/xmp/xmpDM/stretchMode/1=Time-Scale"
"$$$/xmp/xmpDM/stretchMode/2=Resample"
"$$$/xmp/xmpDM/stretchMode/3=Beat Splice"
"$$$/xmp/xmpDM/stretchMode/4=Hybrid"
"$$$/xmp/xmpDM/stretchMode_description=Example: Fixed length, Time-scale"
"$$$/xmp/xmpDM/stretchMode_label=Audio Stretch Mode"
"$$$/xmp/xmpDM/takeNumber_description=Take number."
"$$$/xmp/xmpDM/takeNumber_label=Take Number"
"$$$/xmp/xmpDM/tapeName_description=The name of the tape from which the clip was captured, as set during the capture process."
"$$$/xmp/xmpDM/tapeName_label=Tape Name"
"$$$/xmp/xmpDM/tempo_description=Music pace: example 120 BPM"
"$$$/xmp/xmpDM/tempo_label=Tempo"
"$$$/xmp/xmpDM/time/scale_description=The scale for the time value. For NTSC, use 1001/30000, or the less accurate 100/2997. For PAL, use 1/25."
"$$$/xmp/xmpDM/time/scale_label=Scale"
"$$$/xmp/xmpDM/time/value_description=The time value in the specified scale."
"$$$/xmp/xmpDM/time/value_label=Value"
"$$$/xmp/xmpDM/timeScaleParams_description=Additional Time-Scale parameters"
"$$$/xmp/xmpDM/timeScaleParams_label=Audio Stretch Mode Time-Scale"
"$$$/xmp/xmpDM/timeSignature/0=2/4"
"$$$/xmp/xmpDM/timeSignature/1=3/4"
"$$$/xmp/xmpDM/timeSignature/2=4/4"
"$$$/xmp/xmpDM/timeSignature/3=5/4"
"$$$/xmp/xmpDM/timeSignature/4=7/4"
"$$$/xmp/xmpDM/timeSignature/5=6/8"
"$$$/xmp/xmpDM/timeSignature/6=9/8"
"$$$/xmp/xmpDM/timeSignature/7=12/8"
"$$$/xmp/xmpDM/timeSignature/8=Other"
"$$$/xmp/xmpDM/timeSignature_description=Example: 2/4, 3/4, 4/4"
"$$$/xmp/xmpDM/timeSignature_label=Music Time Signature"
"$$$/xmp/xmpDM/time_description=A representation of a time value in seconds. This is similar to After Effect's TDB, or QuickTime's representation of time. They each have a value, and the scale of the value. For example, if the scale is the rational 1/25 (PAL 25fps), and the value is 50, the time is 2 seconds."
"$$$/xmp/xmpDM/time_label=Time"
"$$$/xmp/xmpDM/timecode/timeFormat/0=24Timecode"
"$$$/xmp/xmpDM/timecode/timeFormat/1=25Timecode"
"$$$/xmp/xmpDM/timecode/timeFormat/10=Frames"
"$$$/xmp/xmpDM/timecode/timeFormat/2=2997DropTimecode"
"$$$/xmp/xmpDM/timecode/timeFormat/3=2997NonDropTimecode"
"$$$/xmp/xmpDM/timecode/timeFormat/4=30Timecode"
"$$$/xmp/xmpDM/timecode/timeFormat/5=50Timecode"
"$$$/xmp/xmpDM/timecode/timeFormat/6=5994DropTimecode"
"$$$/xmp/xmpDM/timecode/timeFormat/7=5994NonDropTimecode"
"$$$/xmp/xmpDM/timecode/timeFormat/8=60Timecode"
"$$$/xmp/xmpDM/timecode/timeFormat/9=23976Timecode"
"$$$/xmp/xmpDM/timecode/timeFormat_description=Example: 25Timecode, 2997DropTimecode"
"$$$/xmp/xmpDM/timecode/timeFormat_label=Time Format"
"$$$/xmp/xmpDM/timecode/timeValue_description=A time value in the specified format. Time values use a colon delimiter in all formats except 2997drop, which uses a semicolon. The four fields indicate hours, minutes, seconds, and frames: hh:mm:ss:ff The actual duration in seconds depends on the format."
"$$$/xmp/xmpDM/timecode/timeValue_label=Time Value"
"$$$/xmp/xmpDM/timecode_description=A time value in video."
"$$$/xmp/xmpDM/timecode_label=Timecode"
"$$$/xmp/xmpDM/timescalestretch/frameOverlappingPercentage_description=Percent of overlap between frames"
"$$$/xmp/xmpDM/timescalestretch/frameOverlappingPercentage_label=Frame Overlapping Percentage"
"$$$/xmp/xmpDM/timescalestretch/frameSize_description=Splices per beat"
"$$$/xmp/xmpDM/timescalestretch/frameSize_label=Frame Size"
"$$$/xmp/xmpDM/timescalestretch/quality/0=High"
"$$$/xmp/xmpDM/timescalestretch/quality/1=Medium"
"$$$/xmp/xmpDM/timescalestretch/quality/2=Low"
"$$$/xmp/xmpDM/timescalestretch/quality_label=Quality"
"$$$/xmp/xmpDM/timescalestretch_description=A set of parameters used when stretching audio using the Time-Scale stretch mode"
"$$$/xmp/xmpDM/timescalestretch_label=Time Scale Stretch"
"$$$/xmp/xmpDM/trackNumber_description=A numeric value indicating the order of the audio file within its original recording."
"$$$/xmp/xmpDM/trackNumber_label=Audio Track Number"
"$$$/xmp/xmpDM/videoAlphaMode/0=Straight"
"$$$/xmp/xmpDM/videoAlphaMode/1=Pre-multiplied"
"$$$/xmp/xmpDM/videoAlphaMode/2=None"
"$$$/xmp/xmpDM/videoAlphaMode_description=Example: straight or pre-multiplied"
"$$$/xmp/xmpDM/videoAlphaMode_label=Video Alpha Mode"
"$$$/xmp/xmpDM/videoAlphaPremultipleColor_description=A color in CMYK or RGB to be used as the pre-multiple color when alpha mode is pre-multiplied."
"$$$/xmp/xmpDM/videoAlphaPremultipleColor_label=Video Alpha Premultiple Color"
"$$$/xmp/xmpDM/videoAlphaUnityIsTransparent_description=True = clear; false = opaque"
"$$$/xmp/xmpDM/videoAlphaUnityIsTransparent_label=Video Alpha Unity Transparency"
"$$$/xmp/xmpDM/videoColorSpace/0=sRGB(used by Photoshop)"
"$$$/xmp/xmpDM/videoColorSpace/1=CCIR-601(used for NTSC)"
"$$$/xmp/xmpDM/videoColorSpace/2=CCIR-709(used for HD)"
"$$$/xmp/xmpDM/videoColorSpace/3=BT.709(used for Panasonic)"
"$$$/xmp/xmpDM/videoColorSpace/4=V-Gamut(used for Panasonic)"
"$$$/xmp/xmpDM/videoColorSpace/5=BT.2020(used for Panasonic)"
"$$$/xmp/xmpDM/videoColorSpace/6=Undefined(used for Panasonic)"
"$$$/xmp/xmpDM/videoColorSpace_description=Example: sRGB, CCIR-601, CCIR-709, BT.709, V-Gamut, BT.2020 or Undefined "
"$$$/xmp/xmpDM/videoColorSpace_label=Video Color Space"
"$$$/xmp/xmpDM/videoCompressor_description=Video compression used. Example: JPEG."
"$$$/xmp/xmpDM/videoCompressor_label=Video Compressor"
"$$$/xmp/xmpDM/videoFieldOrder/0=Upper"
"$$$/xmp/xmpDM/videoFieldOrder/1=Lower"
"$$$/xmp/xmpDM/videoFieldOrder/2=Progressive"
"$$$/xmp/xmpDM/videoFieldOrder_description=Example: upper, lower or progressive"
"$$$/xmp/xmpDM/videoFieldOrder_label=Video Field Order"
"$$$/xmp/xmpDM/videoFrameRate_description=The video frame rate. For example: 29.97"
"$$$/xmp/xmpDM/videoFrameRate_label=Video Frame Rate"
"$$$/xmp/xmpDM/videoFrameSize_description=The frame size. For example: w:720, h: 480, unit:pixels"
"$$$/xmp/xmpDM/videoFrameSize_label=Video Frame Size"
"$$$/xmp/xmpDM/videoModDate_description=Date and time video was last modified"
"$$$/xmp/xmpDM/videoModDate_label=Video Modification Date"
"$$$/xmp/xmpDM/videoPixelAspectRatio_description=Expressed as width/height"
"$$$/xmp/xmpDM/videoPixelAspectRatio_label=Video Pixel Aspect Ratio"
"$$$/xmp/xmpDM/videoPixelDepth/0=8Int"
"$$$/xmp/xmpDM/videoPixelDepth/1=16Int"
"$$$/xmp/xmpDM/videoPixelDepth/2=32Int"
"$$$/xmp/xmpDM/videoPixelDepth/3=32Float"
"$$$/xmp/xmpDM/videoPixelDepth/4=Other"
"$$$/xmp/xmpDM/videoPixelDepth/5=24Int"
"$$$/xmp/xmpDM/videoPixelDepth_description=Size in bits of each color component of a pixel"
"$$$/xmp/xmpDM/videoPixelDepth_label=Video Pixel Depth"
"$$$/xmp/xmpDM/whiteBalanceColorTemperature_description=Value of color temperature associated with white balance in Kelvin. "
"$$$/xmp/xmpDM/whiteBalanceColorTemperature_label=WhiteBalanceColorTemperature"
"$$$/xmp/xmpDM_description=Properties used for dynamic media"
"$$$/xmp/xmpDM_label=Dynamic Media"
"$$$/xmp/xmpG/colorant/A_description=A value when the mode is LAB."
"$$$/xmp/xmpG/colorant/A_label=A"
"$$$/xmp/xmpG/colorant/B_description=B value when the mode is LAB."
"$$$/xmp/xmpG/colorant/B_label=B"
"$$$/xmp/xmpG/colorant/L_description=L value when the mode is LAB."
"$$$/xmp/xmpG/colorant/L_label=L"
"$$$/xmp/xmpG/colorant/black_description=Black value when the mode is CMYK."
"$$$/xmp/xmpG/colorant/black_label=Black"
"$$$/xmp/xmpG/colorant/blue_description=Blue value when the mode is RGB."
"$$$/xmp/xmpG/colorant/blue_label=Blue"
"$$$/xmp/xmpG/colorant/cyan_description=Cyan value when the mode is CMYK."
"$$$/xmp/xmpG/colorant/cyan_label=Cyan"
"$$$/xmp/xmpG/colorant/green_description=Green value when the mode is RGB."
"$$$/xmp/xmpG/colorant/green_label=Green"
"$$$/xmp/xmpG/colorant/magenta_description=Magenta value when the mode is CMYK."
"$$$/xmp/xmpG/colorant/magenta_label=Magenta"
"$$$/xmp/xmpG/colorant/mode/0=CMYK"
"$$$/xmp/xmpG/colorant/mode/1=RGB"
"$$$/xmp/xmpG/colorant/mode/2=LAB"
"$$$/xmp/xmpG/colorant/mode_description=The color space in which the color is defined."
"$$$/xmp/xmpG/colorant/mode_label=Mode"
"$$$/xmp/xmpG/colorant/red_description=Red value when the mode is RGB."
"$$$/xmp/xmpG/colorant/red_label=Red"
"$$$/xmp/xmpG/colorant/swatchName_description=Name of the swatch."
"$$$/xmp/xmpG/colorant/swatchName_label=Swatch Name"
"$$$/xmp/xmpG/colorant/type/0=PROCESS"
"$$$/xmp/xmpG/colorant/type/1=SPOT"
"$$$/xmp/xmpG/colorant/type_description=The type of color."
"$$$/xmp/xmpG/colorant/type_label=Type"
"$$$/xmp/xmpG/colorant/yellow_description=Yellow value when the mode is CMYK."
"$$$/xmp/xmpG/colorant/yellow_label=Yellow"
"$$$/xmp/xmpG/colorant_description=A structure containing the characteristics of a colorant (swatch) used in a document."
"$$$/xmp/xmpG/colorant_label=Colorant"
"$$$/xmp/xmpMM/DerivedFrom_description=A reference to the original document from which this one is derived. It is a minimal reference; missing components can be assumed to be unchanged. For example, a new version might only need to specify the instance ID and version number of the previous version, or a rendition might only need to specify the instance ID and rendition class of the original."
"$$$/xmp/xmpMM/DerivedFrom_label=Derived From"
"$$$/xmp/xmpMM/DocumentID_description=The common identifier for all versions and renditions of a document. It should be based on a UUID; see Document and Instance IDs below."
"$$$/xmp/xmpMM/DocumentID_label=Document ID"
"$$$/xmp/xmpMM/History_description=An ordered array of high-level user actions that resulted in this resource. It is intended to give human readers a general indication of the steps taken to make the changes from the previous version to this one. The list should be at an abstract level; it is not intended to be an exhaustive keystroke or other detailed history."
"$$$/xmp/xmpMM/History_label=History"
"$$$/xmp/xmpMM/InstanceID_description=An identifier for a specific incarnation of a document, updated each time a file is saved. It should be based on a UUID; see Document and Instance IDs below."
"$$$/xmp/xmpMM/InstanceID_label=Instance ID"
"$$$/xmp/xmpMM/LastURL_description=Deprecated for privacy protection."
"$$$/xmp/xmpMM/LastURL_label=Last URL"
"$$$/xmp/xmpMM/ManageTo_description=A URI identifying the managed resource to the asset management system; the presence of this property is the formal indication that this resource is managed. The form and content of this URI is private to the asset management system."
"$$$/xmp/xmpMM/ManageTo_label=Manage To"
"$$$/xmp/xmpMM/ManageUI_description=A URI that can be used to access information about the managed resource through a web."
"$$$/xmp/xmpMM/ManageUI_label=Manage UI"
"$$$/xmp/xmpMM/ManagedFrom_description=A reference to the document as it was prior to becoming managed. It is set when a managed document is introduced to an asset management system that does not currently own it. It may or may not include references to different management systems."
"$$$/xmp/xmpMM/ManagedFrom_label=Managed From"
"$$$/xmp/xmpMM/ManagerVariant_description=Specifies a particular variant of the asset management system. The format of this property is private to the specific asset management system."
"$$$/xmp/xmpMM/ManagerVariant_label=Manager Variant"
"$$$/xmp/xmpMM/Manager_description=The name of the asset management system that manages this resource. Along with xmpMM: ManagerVariant, it tells applications which asset management system to contact concerning this document."
"$$$/xmp/xmpMM/Manager_label=Manager"
"$$$/xmp/xmpMM/OriginalDocumentID_description=The common identifier for the original resource from which the current resource is derived. It should be based on a UUID."
"$$$/xmp/xmpMM/OriginalDocumentID_label=Original Document ID"
"$$$/xmp/xmpMM/RenditionClass_description=The rendition class name for this resource. This property should be absent or set to default for a document version that is not a derived rendition."
"$$$/xmp/xmpMM/RenditionClass_label=Rendition Class"
"$$$/xmp/xmpMM/RenditionOf_description=Deprecated in favor of xmpMM:DerivedFrom. A reference to the document of which this is a rendition."
"$$$/xmp/xmpMM/RenditionOf_label=Rendition Of"
"$$$/xmp/xmpMM/RenditionParams_description=Can be used to provide additional rendition parameters that are too complex or verbose to encode in xmpMM: RenditionClass."
"$$$/xmp/xmpMM/RenditionParams_label=Rendition Params"
"$$$/xmp/xmpMM/SaveID_description=Deprecated. Previously used only to support the xmpMM:LastURL property."
"$$$/xmp/xmpMM/SaveID_label=Save ID"
"$$$/xmp/xmpMM/VersionID_description=The document version identifier for this resource. Each version of a document gets a new identifier, usually simply by incrementing integers 1, 2, 3 . . . and so on. Media management systems can have other conventions or support branching which requires a more complex scheme."
"$$$/xmp/xmpMM/VersionID_label=Version ID"
"$$$/xmp/xmpMM/Versions_description=The version history associated with this resource. Entry 1 is the oldest known version for this document, entry last() is the most recent version. Typically, a media management system would fill in the version information in the metadata on check-in. It is not guaranteed that a complete history of versions from the first to this one will be present in the xmpMM:Versions property. Interior version information can be compressed or eliminated and the version history can be truncated at some point."
"$$$/xmp/xmpMM/Versions_label=Versions"
"$$$/xmp/xmpMM/renditionclass/0=The master document; no additional tokens allowed."
"$$$/xmp/xmpMM/renditionclass/1=A simplified or reduced preview of a version. Additional tokens can provide characteristics. The recommended order is: thumbnail:format:size:colorspace. For example: thumbnail:jpeg, thumbnail:16x16, thumbnail:gif:8x8:bw."
"$$$/xmp/xmpMM/renditionclass/2=Screen resolution or Web rendition."
"$$$/xmp/xmpMM/renditionclass/3=A review proof."
"$$$/xmp/xmpMM/renditionclass/4=A review rendition."
"$$$/xmp/xmpMM/renditionclass/5=A low resolution, full size stand-in."
"$$$/xmp/xmpMM/renditionclass_description=The type of rendition, from a controlled vocabulary of standard names (an open default The master document; no additional tokens allowed. thumbnail A simplified or reduced preview of a version. Additional tokens can provide characteristics. The recommended order is: thumbnail:format:size:colorspace. For example: thumbnail:jpeg, thumbnail:16x16, thumbnail:gif:8x8:bw. screen Screen resolution or Web rendition. proof A review proof. draft A review rendition. low-res A low resolution, full size stand-in."
"$$$/xmp/xmpMM/renditionclass_label=Rendition Class"
"$$$/xmp/xmpMM_description=The XMP Media Management Schema is primarily for use by digital asset management (DAM) systems."
"$$$/xmp/xmpMM_label=Media Management"
"$$$/xmp/xmpRights/Certificate_description=Online rights management certificate."
"$$$/xmp/xmpRights/Certificate_label=Certificate"
"$$$/xmp/xmpRights/Marked_Copyrighted=Copyrighted"
"$$$/xmp/xmpRights/Marked_Public_Domain=Public Domain"
"$$$/xmp/xmpRights/Marked_Unknown=Unknown"
"$$$/xmp/xmpRights/Marked_description=Indicates that this is a rights-managed resource."
"$$$/xmp/xmpRights/Marked_label=Marked"
"$$$/xmp/xmpRights/Owner_description=An unordered array specifying the legal owner(s) of a resource."
"$$$/xmp/xmpRights/Owner_label=Owner"
"$$$/xmp/xmpRights/UsageTerms_description=Text instructions on how a resource can be legally used."
"$$$/xmp/xmpRights/UsageTerms_iptc_description=Enter instructions on how this image can legally be used"
"$$$/xmp/xmpRights/UsageTerms_label=Rights Usage Terms"
"$$$/xmp/xmpRights/WebStatement_description=The location of a web page describing the owner and/or rights statement for this resource."
"$$$/xmp/xmpRights/WebStatement_label=Web Statement"
"$$$/xmp/xmpRights/custom/Marked_label=Copyright Status"
"$$$/xmp/xmpRights/custom/WebStatement_label=Copyright Info URL"
"$$$/xmp/xmpRights_description=This schema includes properties related to rights management. These properties specify information regarding the legal restrictions associated with a resource."
"$$$/xmp/xmpRights_label=Rights Management"
"$$$/xmp/xmpScript/action_description=The action in the shot"
"$$$/xmp/xmpScript/action_label=Action"
"$$$/xmp/xmpScript/dialogSequence_description=List of spoken dialogue"
"$$$/xmp/xmpScript/dialogSet/character_description=Person speaking"
"$$$/xmp/xmpScript/dialogSet/character_label=Character"
"$$$/xmp/xmpScript/dialogSet/dialog_description=Dialogue being spoken"
"$$$/xmp/xmpScript/dialogSet/dialog_label=Dialogue"
"$$$/xmp/xmpScript/dialogSet_label=Dialogue"
"$$$/xmp/xmpScript/marker_description=Character and dialogue group"
"$$$/xmp/xmpScript/sceneSetting/EXT=EXT"
"$$$/xmp/xmpScript/sceneSetting/EXT_INT=EXT/INT"
"$$$/xmp/xmpScript/sceneSetting/INT=INT"
"$$$/xmp/xmpScript/sceneSetting/INT_EXT=INT/EXT"
"$$$/xmp/xmpScript/sceneSetting/POV=POV"
"$$$/xmp/xmpScript/sceneSetting_description=Interior, Exterior, both or P.O.V."
"$$$/xmp/xmpScript/sceneSetting_label=Scene Setting"
"$$$/xmp/xmpScript/sceneTimeOfDay/afternoon=AFTERNOON"
"$$$/xmp/xmpScript/sceneTimeOfDay/continuous=CONTINUOUS"
"$$$/xmp/xmpScript/sceneTimeOfDay/day=DAY"
"$$$/xmp/xmpScript/sceneTimeOfDay/evening=EVENING"
"$$$/xmp/xmpScript/sceneTimeOfDay/later=LATER"
"$$$/xmp/xmpScript/sceneTimeOfDay/momentsLater=MOMENTS LATER"
"$$$/xmp/xmpScript/sceneTimeOfDay/morning=MORNING"
"$$$/xmp/xmpScript/sceneTimeOfDay/night=NIGHT"
"$$$/xmp/xmpScript/sceneTimeOfDay_description=At what time of day the scene is taking place"
"$$$/xmp/xmpScript/sceneTimeOfDay_label=Time of Day"
"$$$/xmp/xmpScript_description=Properties used for scripts"
"$$$/xmp/xmpScript_label=Script"
"$$$/xmp/xmpTPg/Colorants_description=An ordered array of colorants (swatches) that are used in the document (including any in contained documents)."
"$$$/xmp/xmpTPg/Colorants_label=Colorants"
"$$$/xmp/xmpTPg/Fonts_description=An unordered array of fonts that are used in the document (including any in contained documents)."
"$$$/xmp/xmpTPg/Fonts_label=Fonts"
"$$$/xmp/xmpTPg/MaxPageSize_description=The size of the largest page in the document (including any in contained documents)."
"$$$/xmp/xmpTPg/MaxPageSize_label=Max Page Size"
"$$$/xmp/xmpTPg/NPages_description=The number of pages in the document (including any in contained documents)."
"$$$/xmp/xmpTPg/NPages_label=Number of Pages"
"$$$/xmp/xmpTPg/PlateNames_description=An ordered array of plate names that are needed to print the document (including any in contained documents)."
"$$$/xmp/xmpTPg/PlateNames_label=Plate Names"
"$$$/xmp/xmpTPg_description=The Paged-Text schema is used for text appearing on a page in a document."
"$$$/xmp/xmpTPg_label=Paged-Text"
"$$$/xmp/xmp_description=Basic descriptive properties."
"$$$/xmp/xmp_label=Basic"
"$$$/xmp/xpath_description=XML Path Language (XPath), for addressing parts of an XML document; see September 2005 Property Value Types."
"$$$/xmp/xpath_label=XPath"
